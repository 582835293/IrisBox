@@ -1,4 +1,9 @@
 #!/system/bin/sh
+# Iris container adapter: never flash the shared Host boot partition.
+if [ -f /system/etc/iris-root/component.id ]; then
+  echo 'Use the Iris instance Root switch; boot flashing is unavailable.' >&2
+  exit 1
+fi
