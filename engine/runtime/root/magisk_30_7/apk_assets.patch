 # $1 = version string
 # $2 = version code
 env_check() {
+  if [ -f /system/etc/iris-root/component.id ]; then
+    [ "$(cat /system/etc/iris-root/component.id)" = 'iris-magisk-30.7-extensions-v2' ] || return 1
+    [ "$(magisk -V)" = 30700 ] || return 1
+    [ -S /sbin/.magisk/device/socket ] && [ -x /sbin/.magisk/busybox/busybox ] || return 1
+    # This container has no boot image or pre-init policy partition.
+    # Authorization, standard modules and Zygisk use private Guest files.
+    return 0
+  fi
   for file in busybox magiskboot magiskinit util_functions.sh boot_patch.sh; do
     [ -f "$MAGISKBIN/$file" ] || return 1
   done
--- upstream/assets/boot_patch.sh
