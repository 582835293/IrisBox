# Guest has a virtual output. Only the Host opens physical audio devices.
service irisbox_audio /system/bin/app_process /system/bin com.irisbox.audio.AudioBridge guest /data/irisbox_audio/pcm.sock /data/irisbox_audio/token /data/irisbox_audio/guest.status 0 IRISBOX_SESSION
    class late_start
    user root
    group root audio
    seclabel u:r:su:s0
    setenv CLASSPATH /system/framework/irisbox-audio.jar
    disabled
    restart_period 5

on property:sys.boot_completed=1
    start irisbox_audio

# Observe Guest window readiness; private Traceur masking occurs before init.
service irisbox_health /system/bin/sh /system/etc/irisbox-health.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on post-fs-data
    start irisbox_health
