+        }
+    }
+
     // Boost prio which will be restored later
     setpriority(PRIO_PROCESS, 0, -20);
     if (!strcmp(basename(argv[0]), "ueventd")) {
@@ -64,7 +76,8 @@ int main(int argc, char** argv) {
 
