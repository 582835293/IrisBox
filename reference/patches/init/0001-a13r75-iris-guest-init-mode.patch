diff --git a/init/iris_guest_mode.h b/init/iris_guest_mode.h
new file mode 100644
index 0000000..bf5663c
--- /dev/null
+++ b/init/iris_guest_mode.h
@@ -0,0 +1,30 @@
+/*
+ * Project Iris experimental container mode for Android 13 init.
+ *
+ * The ordinary device boot path is unchanged. This flag is set only by an
+ * isolated Guest launcher and the resulting binary is never installed over
+ * the Android Host's /system/bin/init.
+ */
+
+#pragma once
+
+#include <cstdlib>
+#include <cstring>
+
+namespace android {
+namespace init {
+
+inline bool IsIrisGuestMode() {
+    const char* flag = std::getenv("IRIS_GUEST_INIT");
+    return flag != nullptr && std::strcmp(flag, "1") == 0;
+}
+
+// Only the isolated sleep probe may opt out of Android cgroup management.
+// This is not the mode used to boot a desktop or arbitrary init services.
+inline bool IsIrisGuestProbeMode() {
+    const char* flag = std::getenv("IRIS_GUEST_INIT_PROBE");
+    return IsIrisGuestMode() && flag != nullptr && std::strcmp(flag, "1") == 0;
+}
+
+}  // namespace init
+}  // namespace android
