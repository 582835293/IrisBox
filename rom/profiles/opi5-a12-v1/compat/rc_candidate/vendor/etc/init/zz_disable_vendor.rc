# IrisBox OPi5 (Android 12) 容器 Vendor 侧物理硬件与 OP-TEE 服务禁用清单

# 1. OP-TEE 与依赖物理安全硬件的 HAL（KeyMint 改由 guest_vendor.rc 切至纯软件实现）
service tee-supplicant /system/bin/true
    override
    disabled
    oneshot

service vendor.gatekeeper-1-0 /system/bin/true
    override
    disabled
    oneshot

service vendor.weaver-hal-1-0 /system/bin/true
    override
    disabled
    oneshot

service vendor.drm-widevine-hal-1-4 /system/bin/true
    override
    disabled
    oneshot

service vendor.move_data_sh /system/bin/true
    override
    disabled
    oneshot

# 2. 物理摄像头 / 传感器 / 蓝牙 / Wi-Fi / NPU / USB / 硬件编解码
service vendor.camera-provider-2-4 /system/bin/true
    override
    disabled
    oneshot

service vendor.camera-provider-2-4-ext /system/bin/true
    override
    disabled
    oneshot

service vendor.bluetooth-1-0 /system/bin/true
    override
    disabled
    oneshot

service vendor.wifi_hal_legacy /system/bin/true
    override
    disabled
    oneshot

service wpa_supplicant /system/bin/true
    override
    disabled
    oneshot

service hostapd /system/bin/true
    override
    disabled
    oneshot

service vendor.cas-hal-1-2 /system/bin/true
    override
    disabled
    oneshot

service vendor.rknn-1-0 /system/bin/true
    override
    disabled
    oneshot

service vendor.rockit-hal-1-0 /system/bin/true
    override
    disabled
    oneshot

service android-hardware-media-c2-hal-1-1 /system/bin/true
    override
    disabled
    oneshot

